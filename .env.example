# =============================================================================
# Discord Giveaway Bot - Environment Configuration
# =============================================================================

# Discord Bot Token (obtain from https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (obtain from General Information -> Application ID)
CLIENT_ID=your_application_client_id_here

# Guild (Server) IDs for Instant Command Registration
# Supports multiple comma-separated guild IDs (e.g. 1483166185620111363,123456789012345678).
# When set, "npm run deploy" deploys instantly to all specified servers.
# Leave blank to deploy globally to all servers.
GUILD_IDS=1483166185620111363,your_second_guild_id_here
# Alternatively: GUILD_ID=1483166185620111363

# Optional: Comma-separated list of additional whitelisted user snowflake IDs
# User ID 1031935053695037542 is already whitelisted by default in config/whitelist.js.
WHITELISTED_USERS=1031935053695037542

# Whitelist Mode:
# 'true'  = ONLY users on the whitelist can execute /giveaway commands.
# 'false' = Whitelisted users AND users with 'Manage Server' permission can execute commands.
REQUIRE_WHITELIST_ONLY=true
